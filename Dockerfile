# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
COPY . .
# go.sum is generated by `go mod tidy` (run `make setup` once and commit it for reproducible builds).
RUN if [ ! -s go.sum ]; then go mod tidy; fi && go mod download
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/reconcile ./cmd/reconcile

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S app && adduser -S -G app -u 10001 app \
 && mkdir -p /data/uploads && chown -R app:app /data
COPY --from=build /out/ /usr/local/bin/
USER app
ENV APP_PORT=8080 STORAGE_LOCAL_DIR=/data/uploads
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --start-period=20s --retries=3 CMD ["/usr/local/bin/api", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/api"]
