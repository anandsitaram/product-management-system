# Copy to .env and adjust.  cp .env.example .env
APP_ENV=development              # development | production
APP_PORT=8080
LOG_LEVEL=info                   # debug | info | warn | error

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://pms_app:pms_local_password@localhost:5432/pms?sslmode=disable
AUTO_MIGRATE=true                # apply db/migrations on startup (use `make migrate-up` in prod pipelines)

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=pms-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
RATE_LIMIT_AUTH_PER_MIN=10       # per client IP on /auth/*; 0 disables
TRUST_PROXY=false                # true only behind your own reverse proxy (uses last X-Forwarded-For hop)

# First administrator, created only when no ADMIN exists. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-123456

# --- Image storage --------------------------------------------------------
# "local" stores files under STORAGE_LOCAL_DIR (zero setup); "s3" uses any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
PUBLIC_BASE_URL=http://localhost:8080   # base of signed URLs for the local driver
STORAGE_SIGNED_URL_TTL=15m
MAX_UPLOAD_SIZE=5242880          # bytes (5 MiB)
MAX_IMAGES_PER_PRODUCT=5

# S3 / MinIO (when STORAGE_DRIVER=s3). docker compose sets these for you.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000   # host clients use for presigned URLs
STORAGE_BUCKET=pms-images
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true

# --- Ops ------------------------------------------------------------------
OPS_TOKEN=                       # if set, /ready and /metrics require "Authorization: Bearer <token>"
DOCS_ENABLED=true                # serves /docs (Swagger UI) and /openapi.yaml; defaults to false in production
